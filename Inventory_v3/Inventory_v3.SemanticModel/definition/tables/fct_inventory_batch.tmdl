	partition fct_inventory_batch = m
		mode: import
		source =
				let
				    Origen = Sql.Database("a7niicbdnafeziyn7pkezid2ei-xvfrvotyhelefgem6tjbs5rb4q.datawarehouse.fabric.microsoft.com", "LH_Integrated_Business_Planning_Unstructured_Flows"),
				    Silver_fct_inventory_batch = Origen{[Schema="Silver",Item="fct_inventory_batch"]}[Data],
				    #"Personalizada agregada" = Table.AddColumn(Silver_fct_inventory_batch, "Age", each if [ss_days_left] = null then "No Date"
				else if [ss_days_left] < 0 then "Past Stop Ship"
				else if [ss_days_left] < 30 then "< 30 days"
				else if [ss_days_left] < 60 then "< 60 days"
				else if [ss_days_left] < 90 then "< 90 days"
				else if [ss_days_left] <= 120 then "< 120 days"
				else "Healthy (121+)"),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Personalizada agregada",{{"Age", type text}}),
				    #"Personalizada agregada1" = Table.AddColumn(#"Tipo cambiado", "Age_Orden", each if [ss_days_left] = null then 7
				else if [ss_days_left] < 0 then 1
				else if [ss_days_left] < 30 then 2
				else if [ss_days_left] < 60 then 3
				else if [ss_days_left] < 90 then 4
				else if [ss_days_left] <= 120 then 5
				else 6, Int64.Type),
				    #"Personalizada agregada2" = Table.AddColumn(#"Personalizada agregada1", "MP_Key", each Text.From([sku_key]) & "-" & Text.PadStart(Text.From([plant_key]), 4, "0")),
				
				    // NUEVO: Avg_daily con 1 sola fila por llave (la del snapshot más reciente)
				    AvgOrdenado = Table.Buffer(
				        Table.Sort(
				            Table.SelectColumns(Avg_daily, {"Material_Plant_Key", "Avg_Daily_Sales_for_last_6_weeks", "Snapshot_Date"}),
				            {{"Snapshot_Date", Order.Descending}}
				        )
				    ),
				    AvgUnico = Table.Distinct(AvgOrdenado, {"Material_Plant_Key"}),
				
				    // El merge ahora cruza contra AvgUnico (antes era Avg_daily)
				    #"Consultas combinadas" = Table.NestedJoin(#"Personalizada agregada2", {"MP_Key"}, AvgUnico, {"Material_Plant_Key"}, "Avg_daily", JoinKind.LeftOuter),
				    #"Se expandió Avg_daily" = Table.ExpandTableColumn(#"Consultas combinadas", "Avg_daily", {"Avg_Daily_Sales_for_last_6_weeks"}, {"Avg_daily.Avg_Daily_Sales_for_last_6_weeks"}),
				    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Se expandió Avg_daily",{{"Avg_daily.Avg_Daily_Sales_for_last_6_weeks", "Avg Daily Sales SKU"}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Columnas con nombre cambiado",{"MP_Key"})
				in
				    #"Columnas quitadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

