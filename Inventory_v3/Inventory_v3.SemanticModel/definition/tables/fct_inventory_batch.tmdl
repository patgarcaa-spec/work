	column 'Plant Name' =
			
			VAR _k = RIGHT ( "000" & FORMAT ( fct_inventory_batch[plant_key], "0" ), 4 )
			VAR _name = LOOKUPVALUE ( CAT_Plant_Master[Plant], CAT_Plant_Master[Plant_-_Key], _k )
			RETURN _k & " - " & COALESCE ( _name, "()" )
		lineageTag: 801ea5b2-b760-4301-bf2c-169f2fdc860b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Stop Ship Date' =
			
			IF (
			    NOT ISBLANK ( fct_inventory_batch[ss_date] ),
			    FORMAT ( fct_inventory_batch[ss_date], "MMM d, yyyy", "en-US" ),
			    "No date"
			)
		lineageTag: 10872f92-e809-4e55-88b8-567e5bc30fc2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Shelf Life Date' =
			
			IF (
			    NOT ISBLANK ( fct_inventory_batch[sled_date] ),
			    FORMAT ( fct_inventory_batch[sled_date], "MMM d, yyyy", "en-US" ),
			    "No date"
			)
		lineageTag: e4c0e1a8-68cc-444c-b04f-93c140a44b2f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Avg Daily Sales SKU'
		dataType: double
		lineageTag: 39f336df-63d0-4011-80b6-8f92d2aaba12
		summarizeBy: sum
		sourceColumn: Avg Daily Sales SKU

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column max_stor_per =
			
			VAR _ss  = fct_inventory_batch[ss_date]
			VAR _sle = fct_inventory_batch[sled_date]
			RETURN
			    IF ( NOT ISBLANK ( _ss ) && NOT ISBLANK ( _sle ),
			        fct_inventory_batch[sl_days] - DATEDIFF ( _ss, _sle, DAY ) )
		formatString: #,0
		lineageTag: c2de6a16-7cb1-4d23-9e32-99e68e167d0f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

