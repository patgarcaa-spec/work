	measure 'Recommended Action' =
			
			IF ( NOT ( HASONEVALUE ( CAT_Material_Master[Material___Key] )
			        && HASONEVALUE ( CAT_Plant_Master[Plant_-_Key] ) ), BLANK (),
			    VAR _oh = [Sellable Now (detail)]
			    RETURN
			    IF ( ISBLANK ( _oh ) || _oh <= 0, BLANK (),          -- ← el guard anti-fantasma
			        VAR _dfc = [Days Forecast Coverage]
			        VAR _lo  = [DFC Target Lower]
			        VAR _hi  = [DFC Target Ideal]
			        RETURN
			        SWITCH ( TRUE (),
			            ISBLANK ( _dfc ) || ISBLANK ( _lo ), "⚪ No target / demand",
			            _dfc >= _hi, "🟢 Healthy",
			            _dfc >= _lo, "🟡 Plan replenishment",
			            "🔴 Reallocate now" ) ) )
