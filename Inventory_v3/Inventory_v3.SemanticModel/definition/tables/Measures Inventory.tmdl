	measure 'Value Healthy (Driver)' =
			
			VAR _snap = [Latest Snapshot]
			RETURN CALCULATE ( [_Active Measure], fct_inventory_batch[risk_driver] = "Healthy" )
		lineageTag: 3080c32c-87d5-4c56-bc41-fbeed3691f8a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Inventory Exposure' =
			
			[_Active Measure] - [Value Healthy (Driver)]
		lineageTag: f78a53c2-205f-4280-8a86-5f0029c01fe8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stop Ship Exposure %' =
			
			VAR _ss = CALCULATE ( [Inventory Value], fct_inventory_batch[risk_driver] = "Stop Ship" )
			RETURN DIVIDE ( _ss, [Inventory Value] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 62893b2e-031e-4c7e-aea0-bd734f95e56e

	measure 'Days of Sales Coverage' =
			
			VAR _snap  = [Latest Snapshot]
			VAR _oh    = [Sellable Now]
			VAR _hist  = 12 * 7                       -- ventana: 12 semanas de historia
			VAR _weeks =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                DISTINCT ( Weekly_Actuals[Week] ),
			                Weekly_Actuals[Week] <= _snap,
			                Weekly_Actuals[Week] >  _snap - _hist
			            ),
			            "Sales", CALCULATE ( SUM ( Weekly_Actuals[Sales_Cases] ) )
			        ),
			        [Sales] > 0
			    )
			VAR _ranked = ADDCOLUMNS ( _weeks, "rk", RANKX ( _weeks, [Week], , DESC ) )
			VAR _cum =
			    ADDCOLUMNS ( _ranked, "cum",
			        VAR r = [rk]
			        RETURN SUMX ( FILTER ( _ranked, [rk] <= r ), [Sales] ) )
			VAR _totalSales = SUMX ( _weeks, [Sales] )
			VAR _fullWeeks  = COUNTROWS ( FILTER ( _cum, [cum] <= _oh ) )
			VAR _lastCum    = COALESCE ( MAXX ( FILTER ( _cum, [cum] <= _oh ), [cum] ), 0 )
			VAR _nextSales  = MINX ( TOPN ( 1, FILTER ( _cum, [cum] > _oh ), [rk], ASC ), [Sales] )
			VAR _frac       = DIVIDE ( _oh - _lastCum, _nextSales, 0 )
			RETURN
			IF ( _oh <= 0, BLANK (),
			    IF ( _totalSales < _oh,
			        BLANK (),                          -- historia insuficiente para consumir el on-hand
			        ( _fullWeeks + _frac ) * 7 ) )
		formatString: 0
		lineageTag: d40a3e79-fdb5-409c-bccf-2a6c8b1554f3

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Days of Sales Coverage (card)' =
			
			VAR _d = [Days of Sales Coverage]
			RETURN IF ( ISBLANK ( _d ) && [Sellable Now] > 0,
			    "> " & 12 * 7 & " days",
			    FORMAT ( _d, "0" ) & " days" )
		lineageTag: 35ff8ea8-03ff-4359-9202-55a9f26b2db0

	measure 'Sellable Now' =
			
			VAR _snap = [Latest Snapshot]
			RETURN
			CALCULATE (
			      SUM ( fct_inventory_batch[tqoh_cases] )
			    - SUM ( fct_inventory_batch[on_hold_cases] )
			    - SUM ( fct_inventory_batch[blocked_cases] )
			    - SUM ( fct_inventory_batch[on_hold_aged_cases] ),
			    fct_inventory_batch[snapshot_date] = _snap
			)
		lineageTag: 4f2d5423-8912-4f4e-afb7-231461cac240

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last Actuals Week' =
			
			CALCULATE ( MAX ( Weekly_Actuals[Week] ), REMOVEFILTERS ( Weekly_Actuals ) )
		formatString: General Date
		lineageTag: f803c54c-3340-42b2-aae4-3dd3fc501d32

	measure 'Weekly Sales' = SUM ( Weekly_Actuals[Sales_Cases] )
		lineageTag: 0f2d4ee2-f56c-4a5a-872c-15dd6a0ddb6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weekly Forecast' = SUM ( is_sku_ef[Forecast_Cases] )
		lineageTag: 7a1e49f3-ea8d-43e8-872c-0db4d8221cf0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weekly Projection' =
			
			VAR _wk = MAX ( CAT_Calendario[week_start_date] )
			RETURN IF ( _wk <= [Last Actuals Week], [Weekly Sales], [Weekly Forecast] )
		lineageTag: 1b2810a1-3d75-4279-803e-030a75a79c08

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Demand (Basis)' =
			
			SWITCH (
			    SELECTEDVALUE ( 'Demand Basis'[Basis], "Projection" ),
			    "Sales",    [Weekly Sales],
			    "Forecast", [Weekly Forecast],
			    [Weekly Projection]
			)
		lineageTag: 83bc6806-fa90-4e0a-b2fd-1b2f1e6e057e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Available Inventory Wk' =
			
			VAR _basis    = SELECTEDVALUE ( 'Demand Basis'[Basis], "Projection" )
			VAR _snap     = [Latest Snapshot]
			VAR _snapWeek = CALCULATE ( MAX ( CAT_Calendario[week_start_date] ), CAT_Calendario[date] = _snap )
			VAR _wk       = MAX ( CAT_Calendario[week_start_date] )
			VAR _horizon  = _snapWeek + ( 13 * 7 )
			VAR _oh       = CALCULATE ( [Sellable Now (u)], REMOVEFILTERS ( CAT_Calendario ) )
			VAR _cum =
			    CALCULATE ( [Forecast (u)],
			        FILTER ( ALL ( CAT_Calendario ),
			            CAT_Calendario[week_start_date] > _snapWeek
			                && CAT_Calendario[week_start_date] <= _wk ) )
			RETURN
			IF ( _basis = "Sales", BLANK (),
			IF ( _wk < _snapWeek || _wk > _horizon, BLANK (),
			    _oh - COALESCE ( _cum, 0 ) ) )
		lineageTag: cda1f736-e855-4aad-a0e0-3e69a07a8075

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Historical Sellable' =
			
			VAR _u = SELECTEDVALUE ( 'Unit Measure'[Unit Measure Orden], 1 )
			RETURN
			SUMX (
			    VALUES ( fct_inventory_batch[snapshot_date] ),
			    CALCULATE (
			        SWITCH ( _u,
			            0, SUMX ( VALUES ( CAT_Material_Master[Material___Key] ),
			                    CALCULATE (
			                          SUM ( fct_inventory_batch[tqoh_cases] )
			                        - SUM ( fct_inventory_batch[on_hold_cases] )
			                        - SUM ( fct_inventory_batch[blocked_cases] )
			                        - SUM ( fct_inventory_batch[on_hold_aged_cases] ) ) * [Cost per Case] ),
			            2, SUMX ( VALUES ( CAT_Material_Master[Material___Key] ),
			                    DIVIDE (
			                        CALCULATE (
			                              SUM ( fct_inventory_batch[tqoh_cases] )
			                            - SUM ( fct_inventory_batch[on_hold_cases] )
			                            - SUM ( fct_inventory_batch[blocked_cases] )
			                            - SUM ( fct_inventory_batch[on_hold_aged_cases] ) ),
			                        CALCULATE ( MAX ( CAT_Material_Master[Cases_per_Pallet] ) ) ) ),
			            SUM ( fct_inventory_batch[tqoh_cases] )
			                - SUM ( fct_inventory_batch[on_hold_cases] )
			                - SUM ( fct_inventory_batch[blocked_cases] )
			                - SUM ( fct_inventory_batch[on_hold_aged_cases] )
			        )
			    )
			)
		lineageTag: ca935ace-7a7a-4356-9e16-26f560ed5676

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Demand (hist)' =
			
			VAR _basis = SELECTEDVALUE ( 'Demand Basis'[Basis], "Projection" )
			VAR _wk = MAX ( CAT_Calendario[week_start_date] )
			RETURN IF ( _basis <> "Forecast" && _wk <= [Last Actuals Week], [Sales (u)] )
		lineageTag: 76994388-e35f-4dcb-95b5-cfec97f67a5b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Demand (fwd)' =
			
			VAR _basis = SELECTEDVALUE ( 'Demand Basis'[Basis], "Projection" )
			VAR _wk = MAX ( CAT_Calendario[week_start_date] )
			RETURN IF ( _basis <> "Sales" && _wk > [Last Actuals Week], [Forecast (u)] )
		lineageTag: 640771c8-92f1-427c-ab68-49e6c2c0b545

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trend Window' =
			
			VAR _snap     = [Latest Snapshot]
			VAR _snapWeek = CALCULATE ( MAX ( CAT_Calendario[week_start_date] ), CAT_Calendario[date] = _snap )
			VAR _wk       = MAX ( CAT_Calendario[week_start_date] )
			RETURN
			IF (
			    ISFILTERED ( CAT_Calendario[year] ) || ISFILTERED(CAT_Calendario[month_name]),      -- el usuario eligió periodo: manda el slicer
			    1,
			    IF ( _wk >= _snapWeek - 84 && _wk <= _snapWeek + 91, 1, 0 )   -- sin selección: ventana default
			)
		formatString: 0
		lineageTag: b27236df-d0af-4531-a31d-7bbac4943579

	measure 'Cost per Case' =
			
			VAR _snap = [Latest Snapshot]
			RETURN
			DIVIDE (
			    CALCULATE ( SUM ( fct_inventory_batch[total_value_usd] ),
			        REMOVEFILTERS ( CAT_Calendario ),
			        REMOVEFILTERS ( fct_inventory_batch[snapshot_date] ),
			        fct_inventory_batch[snapshot_date] = _snap ),
			    CALCULATE ( SUM ( fct_inventory_batch[tqoh_cases] ),
			        REMOVEFILTERS ( CAT_Calendario ),
			        REMOVEFILTERS ( fct_inventory_batch[snapshot_date] ),
			        fct_inventory_batch[snapshot_date] = _snap ) )
		lineageTag: 19ab357c-9396-4105-9e4c-628f8a2754c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales (u)' =
			
			VAR _u = SELECTEDVALUE ( 'Unit Measure'[Unit Measure Orden], 1 )
			RETURN
			SWITCH ( _u,
			    0, SUMX ( VALUES ( CAT_Material_Master[Material___Key] ),
			            CALCULATE ( SUM ( Weekly_Actuals[Sales_Cases] ) ) * [Cost per Case] ),
			    2, SUMX ( VALUES ( CAT_Material_Master[Material___Key] ),
			            DIVIDE ( CALCULATE ( SUM ( Weekly_Actuals[Sales_Cases] ) ),
			                     CALCULATE ( MAX ( CAT_Material_Master[Cases_per_Pallet] ) ) ) ),
			    SUM ( Weekly_Actuals[Sales_Cases] ) )
		lineageTag: 27d4d93c-e754-43df-88bf-989c401aaee0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast (u)' =
			
			VAR _u = SELECTEDVALUE ( 'Unit Measure'[Unit Measure Orden], 1 )
			RETURN
			SWITCH ( _u,
			    0, SUMX ( VALUES ( CAT_Material_Master[Material___Key] ),
			            CALCULATE ( SUM ( is_sku_ef[Forecast_Cases] ) ) * [Cost per Case] ),
			    2, SUMX ( VALUES ( CAT_Material_Master[Material___Key] ),
			            DIVIDE ( CALCULATE ( SUM ( is_sku_ef[Forecast_Cases] ) ),
			                     CALCULATE ( MAX ( CAT_Material_Master[Cases_per_Pallet] ) ) ) ),
			    SUM ( is_sku_ef[Forecast_Cases] ) )
		lineageTag: d2e7675a-02e6-43e2-91b3-f99e8543d2e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sellable Now (u)' =
			
			VAR _u = SELECTEDVALUE ( 'Unit Measure'[Unit Measure Orden], 1 )
			RETURN
			SWITCH ( _u,
			    0, SUMX ( VALUES ( CAT_Material_Master[Material___Key] ),
			            CALCULATE ( [Sellable Now] ) * [Cost per Case] ),
			    2, SUMX ( VALUES ( CAT_Material_Master[Material___Key] ),
			            DIVIDE ( CALCULATE ( [Sellable Now] ),
			                     CALCULATE ( MAX ( CAT_Material_Master[Cases_per_Pallet] ) ) ) ),
			    [Sellable Now] )
		lineageTag: c9a40b9c-3327-4d2c-85a2-49933001e0ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inventory (hist)' =
			
			VAR _basis = SELECTEDVALUE ( 'Demand Basis'[Basis], "Projection" )
			VAR _u     = SELECTEDVALUE ( 'Unit Measure'[Unit Measure Orden], 1 )
			VAR _snap  = [Latest Snapshot]
			VAR _wk    = MAX ( CAT_Calendario[week_start_date] )
			VAR _snapWeek =
			    CALCULATE ( MAX ( CAT_Calendario[week_start_date] ), CAT_Calendario[date] = _snap )
			VAR _anchor =
			    CALCULATE ( MAX ( fct_inventory_batch[snapshot_date] ),
			        REMOVEFILTERS ( fct_inventory_batch ),
			        REMOVEFILTERS ( CAT_Calendario ),
			        fct_inventory_batch[snapshot_date] <= _wk + 6 )      -- ← + 6: cubre la semana completa
			VAR _anchorWeek =
			    CALCULATE ( MAX ( CAT_Calendario[week_start_date] ),
			        REMOVEFILTERS ( CAT_Calendario ),
			        CAT_Calendario[date] = _anchor )
			VAR _ohAnchorCases =
			    CALCULATE (
			          SUM ( fct_inventory_batch[tqoh_cases] )
			        - SUM ( fct_inventory_batch[on_hold_cases] )
			        - SUM ( fct_inventory_batch[blocked_cases] )
			        - SUM ( fct_inventory_batch[on_hold_aged_cases] ),
			        REMOVEFILTERS ( CAT_Calendario ),
			        REMOVEFILTERS ( fct_inventory_batch[snapshot_date] ),
			        fct_inventory_batch[snapshot_date] = _anchor )
			VAR _ohAnchor =
			    SWITCH ( _u,
			        0, SUMX ( VALUES ( CAT_Material_Master[Material___Key] ),
			                CALCULATE (
			                      SUM ( fct_inventory_batch[tqoh_cases] )
			                    - SUM ( fct_inventory_batch[on_hold_cases] )
			                    - SUM ( fct_inventory_batch[blocked_cases] )
			                    - SUM ( fct_inventory_batch[on_hold_aged_cases] ),
			                    REMOVEFILTERS ( CAT_Calendario ),
			                    REMOVEFILTERS ( fct_inventory_batch[snapshot_date] ),
			                    fct_inventory_batch[snapshot_date] = _anchor ) * [Cost per Case] ),
			        2, SUMX ( VALUES ( CAT_Material_Master[Material___Key] ),
			                DIVIDE (
			                    CALCULATE (
			                          SUM ( fct_inventory_batch[tqoh_cases] )
			                        - SUM ( fct_inventory_batch[on_hold_cases] )
			                        - SUM ( fct_inventory_batch[blocked_cases] )
			                        - SUM ( fct_inventory_batch[on_hold_aged_cases] ),
			                        REMOVEFILTERS ( CAT_Calendario ),
			                        REMOVEFILTERS ( fct_inventory_batch[snapshot_date] ),
			                        fct_inventory_batch[snapshot_date] = _anchor ),
			                    CALCULATE ( MAX ( CAT_Material_Master[Cases_per_Pallet] ) ) ) ),
			        _ohAnchorCases )
			VAR _cumSales =
			    CALCULATE ( [Sales (u)],
			        FILTER ( ALL ( CAT_Calendario ),
			            CAT_Calendario[week_start_date] > _anchorWeek
			                && CAT_Calendario[week_start_date] <= _wk ) )
			RETURN
			IF ( _basis = "Forecast", BLANK (),
			IF ( ISBLANK ( _anchor ) || _wk > _snapWeek, BLANK (),
			    _ohAnchor - COALESCE ( _cumSales, 0 ) ) )
		lineageTag: e2f422dd-b124-430c-94e4-df22be9d9f77

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Target Inventory (u)' =
			
			VAR _u    = SELECTEDVALUE ( 'Unit Measure'[Unit Measure Orden], 1 )
			VAR _snap = [Latest Snapshot]
			VAR _snapWeek = CALCULATE ( MAX ( CAT_Calendario[week_start_date] ), CAT_Calendario[date] = _snap )
			VAR _wk   = MAX ( CAT_Calendario[week_start_date] )
			VAR _inWindow = _wk >= _snapWeek - 84 && _wk <= _snapWeek + 91
			VAR _mats =
			    FILTER (
			        VALUES ( CAT_Material_Master[Material___Key] ),
			        CALCULATE ( [Sellable Now], REMOVEFILTERS ( CAT_Calendario ) ) > 0
			    )
			VAR _tgtCases =
			    SUMX (
			        _mats,
			        VAR _t = CALCULATE ( MAX ( is_target_by_sku[DFC_Target_@_98.5%_CFR] ) )
			        VAR _d = CALCULATE ( DIVIDE ( SUM ( is_sku_ef[Forecast_Cases] ), 7 * 13 ),
			                    REMOVEFILTERS ( CAT_Calendario ),
			                    is_sku_ef[Week] > _snap,
			                    is_sku_ef[Week] <= _snap + ( 13 * 7 ) )
			        RETURN IF ( NOT ISBLANK ( _t ) && _d > 0, _t * _d )
			    )
			RETURN
			IF ( NOT _inWindow, BLANK (),
			    SWITCH ( _u,
			        0, SUMX (
			                _mats,
			                VAR _t = CALCULATE ( MAX ( is_target_by_sku[DFC_Target_@_98.5%_CFR] ) )
			                VAR _d = CALCULATE ( DIVIDE ( SUM ( is_sku_ef[Forecast_Cases] ), 7 * 13 ),
			                            REMOVEFILTERS ( CAT_Calendario ),
			                            is_sku_ef[Week] > _snap,
			                            is_sku_ef[Week] <= _snap + ( 13 * 7 ) )
			                RETURN IF ( NOT ISBLANK ( _t ) && _d > 0, _t * _d * [Cost per Case] ) ),
			        2, SUMX (
			                _mats,
			                VAR _t = CALCULATE ( MAX ( is_target_by_sku[DFC_Target_@_98.5%_CFR] ) )
			                VAR _d = CALCULATE ( DIVIDE ( SUM ( is_sku_ef[Forecast_Cases] ), 7 * 13 ),
			                            REMOVEFILTERS ( CAT_Calendario ),
			                            is_sku_ef[Week] > _snap,
			                            is_sku_ef[Week] <= _snap + ( 13 * 7 ) )
			                RETURN IF ( NOT ISBLANK ( _t ) && _d > 0,
			                    DIVIDE ( _t * _d, CALCULATE ( MAX ( CAT_Material_Master[Cases_per_Pallet] ) ) ) ) ),
			        _tgtCases
			    )
			)
		lineageTag: 82fdf16a-a346-4408-80e4-5b62d861f845

