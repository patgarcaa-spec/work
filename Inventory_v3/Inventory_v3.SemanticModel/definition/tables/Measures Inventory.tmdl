	measure 'Test Fcst Predicate' =
			
			CALCULATE ( SUM ( is_sku_ef[Forecast_Cases] ),
			    REMOVEFILTERS ( CAT_Calendario ),
			    is_sku_ef[Week] = DATE ( 2026, 7, 5 ) )
		lineageTag: 3e40eb93-2456-4189-9776-1e7ea791de77

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Test Dup Rows' =
			
			COUNTROWS ( is_sku_ef )
			    - COUNTROWS ( SUMMARIZE ( is_sku_ef, is_sku_ef[Item], is_sku_ef[Plant_Key], is_sku_ef[Week] ) )
		formatString: 0
		lineageTag: b119622c-be30-4b84-9bc6-7c237091964a

	measure 'Test Implied Days' =
			
			VAR _snap = [Latest Snapshot]
			VAR _daily =
			    SUMX (
			        FILTER ( VALUES ( CAT_Material_Master[Material___Key] ),
			            CALCULATE ( [Sellable Now], REMOVEFILTERS ( CAT_Calendario ) ) > 0 ),
			        CALCULATE ( DIVIDE ( SUM ( is_sku_ef[Forecast_Cases] ), 7 * 13 ),
			            REMOVEFILTERS ( CAT_Calendario ),
			            is_sku_ef[Week] > _snap, is_sku_ef[Week] <= _snap + ( 13 * 7 ) ) )
			RETURN DIVIDE ( [Target Inventory (u)], _daily )
		lineageTag: 4fd08326-0917-434c-921f-e2aff7edb62b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Days Forecast Coverage' =
			
			VAR _snap = [Latest Snapshot]
			VAR _oh   = CALCULATE ( [Sellable Now], REMOVEFILTERS ( CAT_Calendario ) )
			VAR _weeks =
			    ADDCOLUMNS (
			        CALCULATETABLE ( DISTINCT ( is_sku_ef[Week] ),
			            REMOVEFILTERS ( CAT_Calendario ),
			            is_sku_ef[Week] > _snap,
			            is_sku_ef[Week] <= _snap + ( 26 * 7 ) ),
			        "Fcst", CALCULATE ( SUM ( is_sku_ef[Forecast_Cases] ), REMOVEFILTERS ( CAT_Calendario ) ),
			        "Cum",
			            VAR w = [Week]
			            RETURN CALCULATE ( SUM ( is_sku_ef[Forecast_Cases] ),
			                REMOVEFILTERS ( CAT_Calendario ),
			                is_sku_ef[Week] > _snap, is_sku_ef[Week] <= w )
			    )
			VAR _totalFcst = MAXX ( _weeks, [Cum] )
			VAR _fullWeeks = COUNTROWS ( FILTER ( _weeks, [Cum] <= _oh ) )
			VAR _lastCum   = COALESCE ( MAXX ( FILTER ( _weeks, [Cum] <= _oh ), [Cum] ), 0 )
			VAR _firstOver = MINX ( FILTER ( _weeks, [Cum] > _oh ), [Week] )
			VAR _nextFcst  = MAXX ( FILTER ( _weeks, [Week] = _firstOver ), [Fcst] )
			VAR _frac      = DIVIDE ( _oh - _lastCum, _nextFcst, 0 )
			RETURN
			IF ( _oh <= 0, BLANK (),
			    IF ( _totalFcst < _oh, 182, ( _fullWeeks + _frac ) * 7 ) )
		formatString: 0
		lineageTag: 133e13c1-a241-4c07-8def-9d042e523e4e

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Inventory Turns' =
			
			VAR _snap = [Latest Snapshot]
			VAR _sales12w =
			    CALCULATE ( SUM ( Weekly_Actuals[Sales_Cases] ),
			        REMOVEFILTERS ( CAT_Calendario ),
			        Weekly_Actuals[Week] > _snap - 84,
			        Weekly_Actuals[Week] <= _snap )
			VAR _oh = CALCULATE ( [Sellable Now], REMOVEFILTERS ( CAT_Calendario ) )
			RETURN DIVIDE ( _sales12w * ( 52 / 12 ), _oh )
		lineageTag: 4ffc5246-8c21-4356-bea2-6fa911a5640e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DFC Projected (wk)' =
			
			VAR _snap     = [Latest Snapshot]
			VAR _snapWeek = CALCULATE ( MAX ( CAT_Calendario[week_start_date] ), CAT_Calendario[date] = _snap )
			VAR _wk       = MAX ( CAT_Calendario[week_start_date] )
			VAR _oh       = CALCULATE ( [Sellable Now], REMOVEFILTERS ( CAT_Calendario ) )
			VAR _consumed =
			    CALCULATE ( SUM ( is_sku_ef[Forecast_Cases] ),
			        REMOVEFILTERS ( CAT_Calendario ),
			        is_sku_ef[Week] > _snap,
			        is_sku_ef[Week] <= _wk + 6 )
			VAR _remInv = _oh - COALESCE ( _consumed, 0 )
			VAR _weeks =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( DISTINCT ( is_sku_ef[Week] ),
			                REMOVEFILTERS ( CAT_Calendario ),
			                is_sku_ef[Week] > _wk + 6 ),
			            "Fcst", CALCULATE ( SUM ( is_sku_ef[Forecast_Cases] ), REMOVEFILTERS ( CAT_Calendario ) )
			        ),
			        [Fcst] > 0
			    )
			VAR _ranked = ADDCOLUMNS ( _weeks, "rk", RANKX ( _weeks, [Week], , ASC ) )
			VAR _cum = ADDCOLUMNS ( _ranked, "cum",
			        VAR r = [rk] RETURN SUMX ( FILTER ( _ranked, [rk] <= r ), [Fcst] ) )
			VAR _fullWeeks = COUNTROWS ( FILTER ( _cum, [cum] <= _remInv ) )
			VAR _lastCum   = COALESCE ( MAXX ( FILTER ( _cum, [cum] <= _remInv ), [cum] ), 0 )
			VAR _next      = MINX ( TOPN ( 1, FILTER ( _cum, [cum] > _remInv ), [rk], ASC ), [Fcst] )
			VAR _frac      = DIVIDE ( _remInv - _lastCum, _next, 0 )
			RETURN
			IF ( _wk < _snapWeek || _wk > _snapWeek + 84, BLANK (),
			    IF ( _remInv <= 0, 0, ( _fullWeeks + _frac ) * 7 ) )
		lineageTag: edbda714-5b7d-4d64-a025-26e93b68e02d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast 13w' =
			
			VAR _oh = [Sellable Now (detail)]
			RETURN
			IF ( ISBLANK ( _oh ) || _oh <= 0, BLANK (),
			    VAR _u    = SELECTEDVALUE ( 'Unit Measure'[Unit Measure Orden], 1 )
			    VAR _snap = [Latest Snapshot]
			    VAR _cs   = CALCULATE ( SUM ( is_sku_ef[Forecast_Cases] ),
			                    REMOVEFILTERS ( CAT_Calendario ),
			                    is_sku_ef[Week] > _snap,
			                    is_sku_ef[Week] <= _snap + ( 13 * 7 ) )
			    RETURN
			    SWITCH ( _u,
			        0, _cs * [Cost per Case],
			        2, DIVIDE ( _cs, CALCULATE ( MAX ( CAT_Material_Master[Cases_per_Pallet] ) ) ),
			        _cs ) )
		lineageTag: a20d8cf2-2cdf-4d8b-afa2-69ebfd96f49d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sellable Now (detail)' =
			
			CALCULATE ( [Sellable Now (u)], REMOVEFILTERS ( CAT_Calendario ) )
		lineageTag: efdaffec-fe7a-4eb4-a394-6ec1b6476054

