table 'Measures Inventory'
	lineageTag: bc9d13d3-21fa-4b18-a1be-85c2294d272e

	measure 'Latest Snapshot' =
			
			CALCULATE (
			    MAX ( fct_inventory_batch[snapshot_date] ),
			    REMOVEFILTERS ( fct_inventory_batch ),
			    fct_inventory_batch[inventory_source] = "Inventory"
			)
		formatString: General Date
		lineageTag: 47527ecd-f3f2-4705-a74b-00903feceeb7

	measure 'Inventory Value' =
			
			VAR _snap = [Latest Snapshot]
			RETURN CALCULATE ( SUM ( fct_inventory_batch[total_value_usd] ),
			    fct_inventory_batch[snapshot_date] = _snap )
		lineageTag: 53f2bb26-da54-40db-880f-759b583a3d7d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TQOH Cases' =
			
			VAR _snap = [Latest Snapshot]
			RETURN CALCULATE ( SUM ( fct_inventory_batch[tqoh_cases] ),
			    fct_inventory_batch[snapshot_date] = _snap )
		lineageTag: 87fc1625-c992-41ed-a1bb-ae3496a8b743

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TQOH Pallets' =
			
			VAR _snap = [Latest Snapshot]
			RETURN
			CALCULATE (
			    SUMX ( fct_inventory_batch,
			        DIVIDE ( fct_inventory_batch[tqoh_cases],
			                 RELATED ( CAT_Material_Master[Cases_per_Pallet] ) ) ),
			    fct_inventory_batch[snapshot_date] = _snap )
		lineageTag: 124ecb2a-6d41-4e5e-94d4-3821f6b78d7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Active Measure' =
			
			SWITCH (
			    SELECTEDVALUE ( 'Unit Measure'[Unit Measure Orden] ),
			    0, [Inventory Value],
			    1, [TQOH Cases],
			    2, [TQOH Pallets],
			    [Inventory Value]
			)
		lineageTag: 84bd31fb-6fa5-4f25-9ba5-4cadb1c775db

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'Unit Measure'[Unit Measure Orden] ),
				    0, "$#,##0",      // Dollars
				    1, "#,##0",       // Cases
				    2, "#,##0.0",     // Pallets (1 decimal, suelen salir fraccionados)
				    "$#,##0"
				)

	measure 'Total Inventory Snapshot' = [_Active Measure]
		lineageTag: f1628f08-90ee-41aa-bf79-9f0764add8d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prior Snapshot' =
			
			VAR _last = [Latest Snapshot]
			RETURN CALCULATE ( MAX ( fct_inventory_batch[snapshot_date] ),
			    fct_inventory_batch[snapshot_date] < _last,
			    REMOVEFILTERS ( fct_inventory_batch ) )
		formatString: General Date
		lineageTag: 6d615628-ad99-45ff-afeb-bacbe895d944

	measure 'Inventory Value Prior' =
			
			VAR _prior = [Prior Snapshot]
			RETURN CALCULATE ( SUM ( fct_inventory_batch[total_value_usd] ),
			    fct_inventory_batch[snapshot_date] = _prior )
		lineageTag: 9d80478b-1306-482a-a189-f2d3fb6aee49

		annotation PBI_FormatHint = {"isGeneralNumber":true}

