	measure 'At Risk (Sales)' =
			
			-- Unsellable (Sales, tasa promedio 6 semanas) por lote del último snapshot; el total es la suma de lotes
			VAR _snap = [Latest Snapshot]
			RETURN
			SUMX (
			    CALCULATETABLE (
			        SUMMARIZE ( fct_inventory_batch,
			            fct_inventory_batch[sku_key], fct_inventory_batch[plant_key], fct_inventory_batch[batch] ),
			        REMOVEFILTERS ( CAT_Calendario ),
			        fct_inventory_batch[snapshot_date] = _snap
			    ),
			    VAR _oh   = CALCULATE ( SUM ( fct_inventory_batch[tqoh_cases] ),
			                    REMOVEFILTERS ( CAT_Calendario ),
			                    fct_inventory_batch[snapshot_date] = _snap )
			    VAR _days = CALCULATE ( MIN ( fct_inventory_batch[sl_days_left] ),
			                    REMOVEFILTERS ( CAT_Calendario ),
			                    fct_inventory_batch[snapshot_date] = _snap )
			    VAR _rate = CALCULATE ( MAX ( fct_inventory_batch[Avg Daily Sales SKU] ),
			                    REMOVEFILTERS ( CAT_Calendario ),
			                    fct_inventory_batch[snapshot_date] = _snap )
			    VAR _consumo = IF ( _days > 0, COALESCE ( _rate, 0 ) * _days, 0 )   -- tasa negativa se trata como 0 vía COALESCE + el MAX final
			    RETURN IF ( _oh > 0, MAX ( _oh - _consumo, 0 ) )
			)
		formatString: 0
		lineageTag: 96d9c71a-10b7-4c8f-8572-db67546cdf6f

