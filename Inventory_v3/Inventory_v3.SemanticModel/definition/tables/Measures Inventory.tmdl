	measure 'Gap @ Horizon' =
			
			IF ( NOT ( HASONEVALUE ( CAT_Material_Master[Material___Key] )
			        && HASONEVALUE ( CAT_Plant_Master[Plant_-_Key] ) ), BLANK (),
			    VAR _u    = SELECTEDVALUE ( 'Unit Measure'[Unit Measure Orden], 1 )
			    VAR _snap = [Latest Snapshot]
			    VAR _oh   = CALCULATE ( [Sellable Now], REMOVEFILTERS ( CAT_Calendario ) )
			    VAR _f    = CALCULATE ( SUM ( is_sku_ef[Forecast_Cases] ),
			                    REMOVEFILTERS ( CAT_Calendario ),
			                    is_sku_ef[Week] > _snap,
			                    is_sku_ef[Week] <= _snap + ( 13 * 7 ) )
			    VAR _gap  = MAX ( COALESCE ( _f, 0 ) - _oh, 0 )
			    RETURN
			    SWITCH ( _u,
			        0, _gap * [Cost per Case],
			        2, DIVIDE ( _gap, CALCULATE ( MAX ( CAT_Material_Master[Cases_per_Pallet] ) ) ),
			        _gap )
			)
		lineageTag: f74a4de4-d254-4f40-98c7-01754181ee68

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stockout Week' =
			
			IF ( NOT ( HASONEVALUE ( CAT_Material_Master[Material___Key] )
			        && HASONEVALUE ( CAT_Plant_Master[Plant_-_Key] ) ), BLANK (),
			    VAR _dfc = [Days Forecast Coverage]
			    RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( _dfc ), BLANK (),
			        _dfc >= 91, "No risk",                 -- fuera del horizonte táctico (13 sem)
			        "W+" & ROUNDUP ( _dfc / 7, 0 ) ) )
