	measure 'At Risk Cases' =
			
			-- Unsellable (Fcst) por lote (sku × planta × batch) del último snapshot; el total es la suma de lotes
			VAR _snap = [Latest Snapshot]
			RETURN
			SUMX (
			    CALCULATETABLE (
			        SUMMARIZE ( fct_inventory_batch,
			            fct_inventory_batch[sku_key], fct_inventory_batch[plant_key], fct_inventory_batch[batch] ),
			        REMOVEFILTERS ( CAT_Calendario ),
			        fct_inventory_batch[snapshot_date] = _snap
			    ),
			    VAR _sku   = fct_inventory_batch[sku_key]
			    VAR _plant = fct_inventory_batch[plant_key]   -- para el TREATAS de planta (hallazgo 7)
			    VAR _oh   = CALCULATE ( SUM ( fct_inventory_batch[tqoh_cases] ),
			                    REMOVEFILTERS ( CAT_Calendario ),
			                    fct_inventory_batch[snapshot_date] = _snap )
			    VAR _days = CALCULATE ( MIN ( fct_inventory_batch[sl_days_left] ),
			                    REMOVEFILTERS ( CAT_Calendario ),
			                    fct_inventory_batch[snapshot_date] = _snap )
			    VAR _consumo =
			        IF ( _days > 0,
			            CALCULATE ( SUM ( is_sku_ef[Forecast_Cases] ),
			                REMOVEFILTERS ( CAT_Calendario ),
			                REMOVEFILTERS ( CAT_Material_Master ),
			                REMOVEFILTERS ( CAT_Plant_Master ),
			                TREATAS ( { _sku }, is_sku_ef[Item] ),
			                -- TREATAS ( { _plant }, is_sku_ef[Plant_Key] ),   -- activar cuando el cliente resuelva el hallazgo 7 (forecast por nodo vs planta)
			                is_sku_ef[Week] > _snap,
			                is_sku_ef[Week] <= _snap + _days ),
			            0 )
			    RETURN IF ( _oh > 0, MAX ( _oh - COALESCE ( _consumo, 0 ), 0 ) )
			)
		lineageTag: e71a6047-e5b3-42a9-b252-66e91856e7a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

