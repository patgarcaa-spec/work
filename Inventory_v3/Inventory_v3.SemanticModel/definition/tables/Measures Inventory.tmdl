	measure 'Value At Risk' =
			
			CALCULATE ( [_Active Measure],
			    fct_inventory_batch[Age] IN { "Past Stop Ship", "< 30 days", "< 60 days", "< 90 days", "< 120 days" } )
		displayFolder: Aging
